# Placeholders seguros. Nunca inclua credenciais, IDs ou URLs reais neste arquivo.
APP_ENV=local
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PROJECT_REF=replace-with-fictitious-project-ref
SUPABASE_ALLOWED_PROJECT_REF=replace-with-fictitious-project-ref
SUPABASE_SECRET_KEY=replace-with-backend-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-development-key
# Staging transacional: use a URL privada do Session Pooler na porta 5432.
SUPABASE_DB_URL=replace-with-private-session-pooler-url-on-port-5432

# Valores de exemplo; a credencial real deve permanecer fora do repositorio.
GOOGLE_SERVICE_ACCOUNT_FILE=/secure/path/outside-repository/service-account.json
GOOGLE_TEST_SPREADSHEET_ID=replace-with-fictitious-private-fixture-id
GOOGLE_TEST_SHEET_NAME=replace-with-fixture-tab-name
GOOGLE_TEST_OPTIONAL_RANGE=
GOOGLE_HTTP_TIMEOUT_SECONDS=15
GOOGLE_RETRY_MAX_ATTEMPTS=4
GOOGLE_RETRY_BASE_DELAY_SECONDS=1
GOOGLE_RETRY_MAX_DELAY_SECONDS=16
GOOGLE_RETRY_MAX_ELAPSED_SECONDS=45
GOOGLE_RETRY_JITTER_RATIO=0.2
