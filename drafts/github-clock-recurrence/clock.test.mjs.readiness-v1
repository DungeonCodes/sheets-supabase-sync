import fs from 'node:fs';
import assert from 'node:assert/strict';
import test from 'node:test';
import {assessExecution, assessTick} from './observation.mjs';
const yaml = fs.readFileSync(new URL('./staging-clock.candidate.yml',import.meta.url),'utf8');
const program = yaml.split('// CLOCK_PROGRAM_BEGIN')[1].split('// CLOCK_PROGRAM_END')[0].split('\n').slice(1).map(line=>line.replace(/^          /,'')).join('\n');
const AsyncFunction = Object.getPrototypeOf(async function(){}).constructor;
const sha='a'.repeat(40);
const repository = yaml.match(/const repository = '([^']+)'/)[1];
const base={GITHUB_REPOSITORY:repository,GITHUB_REF:'refs/heads/main',GITHUB_WORKFLOW_REF:`${repository}/.github/workflows/staging-clock.yml@refs/heads/main`,GITHUB_RUN_ATTEMPT:'1',GITHUB_RUN_ID:'123',GITHUB_RUN_NUMBER:'9',AUTHORIZED_RUN_NUMBER:'9',CLOCK_ENABLED:'true',CONFIRM_DISPATCH:'true',EXPECTED_DEV_SHA:sha,APPROVED_DEV_SHA:sha,APPROVAL_EXPIRES_AT:new Date(Date.now()+600000).toISOString(),GH_TOKEN:'synthetic-token',GITHUB_EVENT_NAME:'workflow_dispatch',SCHEDULE_ENABLED:'true'};
async function execute(patch={}, scenario='ok') {
  const calls=[],logs=[],process={env:{...base,...patch},exitCode:0};
  const fetch = async (url,options) => {
    calls.push({url,method:options.method,body:options.body});
    if(scenario==='offline' || (scenario==='ambiguous' && options.method==='POST')) throw Error('synthetic transport failure');
    let data;
    if(url.includes('/git/ref/')) data={object:{type:'commit',sha:scenario==='changed'?'b'.repeat(40):sha}};
    else if(options.method==='POST') data={workflow_run_id:456,run_url:`https://api.github.com/repos/${repository}/actions/runs/456`,html_url:`https://github.com/${repository}/actions/runs/456`};
    else if(url.includes('/runs?')) data={workflow_runs:scenario==='busy'?[{head_branch:'dev',status:'in_progress'}]:[]};
    else if(url.endsWith('/runs/456')) data={id:456,workflow_id:789,event:'workflow_dispatch',head_branch:'dev',head_sha:scenario==='race'?'b'.repeat(40):sha,run_attempt:1,status:'queued'};
    else data={id:789,state:'active',path:'.github/workflows/scheduled-sync.yml'};
    return {status:scenario==='http' ? 503:200,json:async()=>data};
  };
  await new AsyncFunction('process','fetch','console','AbortSignal',program)(process,fetch,{log:x=>logs.push(x),error:x=>logs.push(x)},AbortSignal);
  assert(!logs.join('').includes('synthetic-token'));
  return {calls,logs:logs.map(JSON.parse),code:process.exitCode,posts:calls.filter(c=>c.method==='POST')};
}
test('manual authorized and scheduled authorized dispatch exactly one attempt with fixed payload', async()=>{
  for(const mode of ['workflow_dispatch','schedule']) {
    const r=await execute({GITHUB_EVENT_NAME:mode,...(mode==='schedule'?{CLOCK_ENABLED:'',AUTHORIZED_RUN_NUMBER:'',CONFIRM_DISPATCH:'',EXPECTED_DEV_SHA:'',APPROVAL_EXPIRES_AT:''}:{SCHEDULE_ENABLED:''})});
    assert.equal(r.code,0); assert.equal(r.posts.length,1); assert.deepEqual(JSON.parse(r.posts[0].body),{ref:'dev'});
    assert.equal(r.logs.at(-1).executor_run_id,456);
  }
});
const blocks=[['manual disabled',{CLOCK_ENABLED:''}],['confirmation',{CONFIRM_DISPATCH:'false'}],['run authorization',{AUTHORIZED_RUN_NUMBER:'10'}],['expiry',{APPROVAL_EXPIRES_AT:'2000-01-01T00:00:00Z'}],['window too long',{APPROVAL_EXPIRES_AT:new Date(Date.now()+3600000).toISOString()}],['manual SHA',{EXPECTED_DEV_SHA:'invalid'}],['scheduled absent',{GITHUB_EVENT_NAME:'schedule',SCHEDULE_ENABLED:''}],['scheduled disabled',{GITHUB_EVENT_NAME:'schedule',SCHEDULE_ENABLED:'false'}],['scheduled strict value',{GITHUB_EVENT_NAME:'schedule',SCHEDULE_ENABLED:'TRUE'}],['approval absent',{GITHUB_EVENT_NAME:'schedule',APPROVED_DEV_SHA:''}],['approval invalid',{GITHUB_EVENT_NAME:'schedule',APPROVED_DEV_SHA:'dev'}],['ref fixed',{GITHUB_REF:'refs/heads/other'}],['repository fixed',{GITHUB_REPOSITORY:'example/other'}],['workflow fixed',{GITHUB_WORKFLOW_REF:'invalid'}],['rerun',{GITHUB_RUN_ATTEMPT:'2'}],['event',{GITHUB_EVENT_NAME:'push'}],['token absent',{GH_TOKEN:''}]];
for(const [name,patch] of blocks) test(name,async()=>{const r=await execute(patch);assert.equal(r.code,1);assert.equal(r.calls.length,0);});
for(const scenario of ['offline','http','changed','busy']) test(scenario,async()=>{const r=await execute({},scenario);assert.equal(r.posts.length,0);assert.equal(r.code,scenario==='busy'?0:1);});
for(const scenario of ['ambiguous','race']) test(scenario+' never retry',async()=>{const r=await execute({},scenario);assert.equal(r.posts.length,1);assert.equal(r.code,1);});
test('candidate isolation and shared concurrency',()=>{
  assert(!/^\s*schedule:/m.test(yaml)); assert(!/secrets\.|environment:|uses:|checkout|retry:/m.test(yaml.replace(/#.*$/gm,'')));
  assert.match(yaml,/group: staging-clock\s+cancel-in-progress: false/);
  assert.match(yaml,/actions: write/); assert.match(yaml,/contents: read/);
});
const summary={sources_due:1,sources_executed:1,sources_failed:0,sources_busy_deferred:0};
test('partial failure with zero exit alerts',()=>assert.equal(assessExecution({...summary,sources_failed:1},0,'success'),'failure_alert'));
test('staging unavailable alerts',()=>assert.equal(assessExecution(summary,2,'failure'),'failure_alert'));
test('missing summary alerts',()=>assert.equal(assessExecution(null,0,'success'),'unknown_alert'));
test('no eligible sources is observable success',()=>assert.equal(assessExecution({...summary,sources_due:0,sources_executed:0},0,'success'),'no_eligible_sources'));
test('busy requires reconciliation',()=>assert.equal(assessExecution({...summary,sources_busy_deferred:1},0,'success'),'busy_reconcile'));
for(const [name,patch,result] of [['missed',{observedAt:null},'missing_alert'],['late',{observedAt:120},'late_alert'],['disabled',{enabled:false},'disabled'],['inactive workflow',{workflowActive:false},'workflow_disabled_alert'],['on time',{observedAt:100},'on_time']]) test(name,()=>assert.equal(assessTick({enabled:true,workflowActive:true,expectedAt:100,observedAt:null,now:200,toleranceMs:10,...patch}),result));
